rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidPresence(data, sessionId) {
      return data.sessionId is string &&
             data.sessionId == sessionId &&
             data.sessionId.size() <= 128 &&
             data.lastSeen is timestamp;
    }

    // Real-time Devotees Presence Collection
    match /presence/{sessionId} {
      allow read: if isValidId(sessionId);
      allow create: if isValidId(sessionId) &&
                    isValidPresence(incoming(), sessionId) &&
                    incoming().keys().hasAll(['sessionId', 'lastSeen']) &&
                    incoming().keys().size() <= 4;
      allow update: if isValidId(sessionId) &&
                    isValidPresence(incoming(), sessionId) &&
                    incoming().sessionId == sessionId;
      allow delete: if isValidId(sessionId);
    }

    // Global Stats & Peak Tracking
    match /stats/{statId} {
      allow read: if isValidId(statId);
      allow write: if isValidId(statId) &&
                   incoming().updatedAt is timestamp;
    }
  }
}
