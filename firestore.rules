rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Real-time Devotees Presence Collection (Least-read session tracking)
    match /presence/{sessionId} {
      allow read: if true;
      allow write: if sessionId is string && sessionId.size() <= 128;
    }

    // Global Stats & Live Presence Single Document (O(1) read cost for all users)
    match /stats/{statId} {
      allow read: if true;
      allow write: if statId is string && statId.size() <= 128;
    }
  }
}
